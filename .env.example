# Codebase X-Ray Configuration
PROJECT_NAME="Codebase X-Ray"
TAGLINE="See Beyond the Code."

# Database (defaults to local SQLite if omitted; accepts PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/codebase_xray
DATABASE_URL=sqlite:///storage/codebase_xray.db

# Optional External AI API Keys (Kept strictly on the backend)
# When omitted, the built-in deterministic AST grounded reasoning engine runs automatically.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional GitHub Token (Increases rate limits for public GitHub repo ingestion)
GITHUB_TOKEN=

# Ingestion & Security Limits
MAX_ZIP_SIZE_MB=50
MAX_FILE_COUNT=2500
